{
  "name": "sports-cms",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise Sports Competition Management System",
  "scripts": {
    "dev": "concurrently \"pnpm --filter @sports-cms/api dev\" \"pnpm --filter @sports-cms/web dev\"",
    "dev:api": "pnpm --filter @sports-cms/api dev",
    "dev:web": "pnpm --filter @sports-cms/web dev",
    "build": "pnpm --filter @sports-cms/api build && pnpm --filter @sports-cms/web build",
    "db:migrate": "pnpm --filter @sports-cms/api prisma:migrate",
    "db:seed": "pnpm --filter @sports-cms/api prisma:seed",
    "db:studio": "pnpm --filter @sports-cms/api prisma:studio"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  },
  "engines": {
    "node": ">=20"
  }
}
