# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sports_cms?schema=public"

# JWT
JWT_SECRET="change-this-to-a-long-random-string-at-least-32-chars"
JWT_REFRESH_SECRET="another-long-random-string-for-refresh-tokens"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="7d"

# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN="http://localhost:3000"

# Frontend
NEXT_PUBLIC_API_URL="http://localhost:4000/api"

# File uploads (local for dev)
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=5242880

# Optional: S3 / R2
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=auto
